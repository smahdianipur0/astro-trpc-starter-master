<div id="byebye">Loading...</div>

<script>
import { trpc } from "../utils/trpc";
import swr from "../utils/swr";


async function helloGetter() {
  return await swr.swrFetch("hello", () => 
  trpc.greeting.query())
}


const[data, error] = await helloGetter();
if ( data || error) {
  document.getElementById("byebye")!.textContent = data?.bye ?? error?.message ?? "";
}


swr.revalidatListener(async() => {
  const[data, error] = await helloGetter();
  if ( data || error) {
  document.getElementById("byebye")!.textContent = data?.bye ?? error?.message ?? "" ;
  }
});


</script>