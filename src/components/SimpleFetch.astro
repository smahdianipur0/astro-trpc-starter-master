<div id="byebye">Loading...</div>

<script>
import { trpc } from "../utils/trpc";
import queryData, {cache} from '../utils/swr';
type helloRes = { message: string; [key: string]: unknown };

async function helloGetter() {
  return await queryData.fetch("hello", () => 
  trpc.greeting.query())
}

async function helloHandler() {
  const cached: helloRes = cache.get("hello");
  if (cached?.message){
    document.getElementById("byebye")!.textContent = cached?.message;
  }

  const [data, error] = await helloGetter();
  if ( queryData.invalidateCache(cached, data, error)) {
    document.getElementById("byebye")!.textContent = data?.message ?? error?.message ?? "";
  }
}


await helloHandler();
queryData.revalidatListener(async() => await helloHandler());

</script>