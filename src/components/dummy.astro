<div id="dummy">Loading...</div>

<script>

import queryData, {cache} from '../utils/swr';
type dummyRes = { pokemon: string; [key: string]: unknown };

async function dummyHandler() {
  const cached: dummyRes = cache.get("dummy");
  if (cached?.pokemon){
    document.getElementById("dummy")!.textContent = cached?.pokemon;
  }

  const [data, error] = await queryData.fetch("dummy", () => 
    fetch('https://dummyapi.online/api/pokemon/7').then(res => res.json()));

  if ( queryData.invalidateCache(cached, data, error)) {
    document.getElementById("dummy")!.textContent = data?.pokemon ?? error?.message;
  }
};

const testing = "dummy"
console.log(testing);

await dummyHandler();
queryData.revalidatListener( async()=> await dummyHandler());

</script>