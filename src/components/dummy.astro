<div id="dummy">Loading...</div>

<script>

import swr from "../utils/swr";

async function dummyGetter() {
  return await swr.swrFetch("dummy", () => 
  fetch('https://dummyapi.online/api/pokemon/7').then(res => res.json()))
}

async function dummyHandler() {
  const [data, error] = await dummyGetter();
  if ( data || error) {
  document.getElementById("dummy")!.textContent = data?.pokemon ?? error?.message;
  }
};

await dummyHandler();
swr.revalidatListener( async()=> await dummyHandler());

</script>