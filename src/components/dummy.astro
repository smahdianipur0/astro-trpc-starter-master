<div id="dummy">Loading...</div>

<script>
import { createEffect } from 'solid-js';
import swr from "../utils/swr";

const [dataSignal, errorSignal] = await swr.swrFetch("dummy", () => 
  fetch('https://dummyapi.online/api/pokemon/4').then(res => res.json())
);

// if needed
// swr.cleanup("dummy"); 

createEffect(() => {
  const dummyElement = document.getElementById("dummy") as HTMLElement | null;
  if (dummyElement) {
    dummyElement.textContent = dataSignal()?.pokemon ?? errorSignal()?.message;
  }
});
</script>